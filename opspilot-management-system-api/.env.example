# APPLICATION
SPRING_PROFILES_ACTIVE=dev
APP_NAME=opspilot-api
SERVER_PORT=8080
API_BASE_PATH=/api/v1
LOG_LEVEL=INFO

# DATABASE
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=opspilot
# Dev local có thể dùng postgres (RLS không hiệu lực, ứng dụng chỉ cảnh báo).
# Profile prod BẮT BUỘC opspilot_app: từ chối khởi động nếu rls_session_check() không đạt.
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_SSLMODE=disable
FLYWAY_ENABLED=false

# SWAGGER
SWAGGER_ENABLED=true
SWAGGER_FILTER_ENABLED=true
SWAGGER_TRY_IT_OUT_ENABLED=true

# RATE LIMIT
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_CLIENT_IDLE_MINUTES=15

# SECURITY
# JWT_SECRET bắt buộc (>= 32 byte), không commit giá trị thật. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=opspilot-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_TTL_MOBILE_DAYS=30
REFRESH_COOKIE_NAME=opspilot_rt
# Chỉ đặt false khi dev qua HTTP trên host không phải localhost.
REFRESH_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

# STORAGE — RESERVED (chưa được bind cho đến khi module lưu trữ được triển khai)
STORAGE_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI — RESERVED (chưa được bind cho đến khi module AI được triển khai)
AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# EMAIL — RESERVED (chưa được bind cho đến khi module email được triển khai)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Docker runtime JVM, không phải Spring property.
JVM_MEMORY_OPTIONS=-XX:MaxRAMPercentage=75.0

# TEAM STACK — PostgreSQL do compose.team.yaml quản lý
# Sao chép sang .env.local và đặt mật khẩu cục bộ; không commit mật khẩu.
TEAM_DB_NAME=opspilot
TEAM_DB_SUPERUSER=postgres
TEAM_DB_PASSWORD=
TEAM_DB_PORT=55432
TEAM_DB_TIMEZONE=Asia/Ho_Chi_Minh
TEAM_API_PORT=8080
